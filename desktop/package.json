{
  "name": "universalai-messenger-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "UniversalAI Messenger — тонкая desktop-обёртка вокруг существующего веб-мессенджера (та же страница /messenger, тот же Chromium-движок). Функционал не меняется — просто нативное окно, значок в трее и фоновая связь для статуса «отошёл».",
  "homepage": "https://192.0.2.8",
  "author": "UniversalAI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.universalai.messenger",
    "productName": "UniversalAI Messenger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "UniversalAI"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
