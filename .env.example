# ── Режим приложения ──────────────────────────────────────────────────────────
APP_ENV=development
# Включайте только для изолированной разработки. По умолчанию используется вход.
ALLOW_ANONYMOUS=false
LOG_LEVEL=INFO

# ── База данных ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-a-long-random-password
MESSENGER_DB_PASSWORD=replace-with-a-different-long-random-password
# For app outside Docker pointing at compose Postgres use host port 5433.
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@localhost:5433/universalai

# ── Безопасность ──────────────────────────────────────────────────────────────
AI_FLASK_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false

# ── SSO (обязательно при ALLOW_ANONYMOUS=false) ───────────────────────────────
AI_SSO_SHARED_SECRET=
AI_SSO_MAX_AGE_SEC=300
# Включать только после выдачи UniversalAI отдельного HTTPS-адреса и
# настройки такого же секрета в .env.production портала.
PORTAL_SSO_REQUIRED=false
UNIVERSALAI_PUBLIC_URL=
# Порт loopback для docker-compose.portal.yml. Укажите тот же порт в Nginx хоста.
# UNIVERSALAI_GATEWAY_PORT=8085
PORTAL_LOGIN_URL=https://portal.example.com/login
PORTAL_LOGOUT_URL=https://portal.example.com/logout
# Если на портале включён БелнипиAI, сюда вписать его фиксированный logout URL.
PORTAL_SSO_LOGOUT_CONTINUE_URL=https://ai.example.com/sso-logout

# ── Active Directory / LDAP ──────────────────────────────────────────────────
# В production используйте только ldaps:// и рабочий сертификат.
LDAP_URI=ldaps://ad.example.local:636
LDAP_BASE_DN=DC=example,DC=local
LDAP_BIND_DN=CN=svc-universalai,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=
# CN или полный DN групп, которые получают роль admin (вложенные группы учитываются).
LDAP_ADMIN_GROUPS=UniversalAI Admins
LDAP_TIMEOUT_SEC=5
# Синхронизация справочника: раз в N минут выгружаются все сотрудники
# (ФИО, отдел, должность, почта, телефон, кабинет); отключённые и удалённые
# в AD сразу теряют доступ. Работает, только когда заполнены LDAP_URI,
# LDAP_BASE_DN, LDAP_BIND_DN и LDAP_BIND_PASSWORD.
LDAP_SYNC_INTERVAL_MIN=15
LDAP_SYNC_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName=*))
LDAP_TLS_VALIDATE=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SEC=300

# ── Messenger service identity ───────────────────────────────────────────────
# Generate an Ed25519 pair with: python scripts/generate_messenger_keys.py
# Paste the escaped one-line values printed by the script. Never commit real keys.
MESSENGER_JWT_PRIVATE_KEY=
MESSENGER_JWT_PUBLIC_KEY=
MESSENGER_JWT_KEY_ID=local-1
MESSENGER_JWT_ISSUER=universalai
MESSENGER_JWT_AUDIENCE=messenger
MESSENGER_JWT_TTL_SEC=300
MESSENGER_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
MESSENGER_ALLOWED_HOSTS=localhost,127.0.0.1,messenger-api
MESSENGER_MESSAGE_RETENTION_DAYS=365
MESSENGER_AUDIT_RETENTION_DAYS=365
MESSENGER_ATTACHMENT_MAX_BYTES=26214400
MESSENGER_ATTACHMENT_ORPHAN_HOURS=24
MESSENGER_CLAMAV_TIMEOUT_SECONDS=30
MESSENGER_CALL_RING_TIMEOUT_SECONDS=45
MESSENGER_CALL_MAX_DURATION_SECONDS=21600
# 1:1 and group calls — LiveKit SFU (self-hosted). API key/secret are shared only
# between messenger-api and the livekit container, never sent to clients.
MESSENGER_LIVEKIT_URL=ws://localhost:7880
# Internal (container-to-container) address messenger-api uses for its own
# admin-API calls (token minting doesn't need this, but the group-call
# reconciliation sweep does) — normally left at the default, browsers never
# see this value.
MESSENGER_LIVEKIT_INTERNAL_URL=http://livekit:7880
MESSENGER_LIVEKIT_API_KEY=replace-with-a-livekit-api-key
MESSENGER_LIVEKIT_API_SECRET=replace-with-a-long-random-secret
MESSENGER_GROUP_CALL_TOKEN_TTL_SECONDS=21600
# Public IP/DNS of the host running LiveKit — required in production; the
# container cannot infer its own public-facing address.
MESSENGER_LIVEKIT_EXTERNAL_IP=
# Users with access to audit metadata; this role never grants message access.
MESSENGER_AUDITOR_USERS=

# ── Encrypted backups (operations profile) ──────────────────────────────────
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-separate-long-random-passphrase
BACKUP_RETENTION_DAYS=30

# ── Локальные учётные записи без AD ─────────────────────────────────────────
# Укажите уникальные пароли в .env (не короче 12 символов, не admin123/test123 —
# иначе приложение не стартует). Пустой пароль — учётка не создаётся и не обновляется.
# При изменении пароля hash обновится на старте.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_DISPLAY_NAME=Администратор
LOCAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
LOCAL_TEST_USERNAME=test
LOCAL_TEST_DISPLAY_NAME=Тестовый пользователь
LOCAL_TEST_PASSWORD=replace-with-a-strong-test-password
LOCAL_FOORY_USERNAME=foory
LOCAL_FOORY_DISPLAY_NAME=foory
LOCAL_FOORY_PASSWORD=replace-with-a-strong-foory-password
